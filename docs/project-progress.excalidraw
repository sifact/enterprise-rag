  },
  {
   "id": "g3_body",
   "type": "text",
   "x": 1494,
   "y": 2588,
   "width": 572.88,
   "height": 682.5,
   "angle": 0,
   "strokeColor": "#3d3d3d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 589504031,
   "version": 1,
   "versionNonce": 2008910112,
