  {
   "id": "g2_h",
   "type": "text",
   "x": 770,
   "y": 2544,
   "width": 267.84,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#3d3d3d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
